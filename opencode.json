{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "prettier": {
      "extensions": [".ts", ".js", ".json", ".md"]
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "npm test*": "allow",
      "npm run*": "allow",
      "make dev*": "allow",
      "make test*": "allow",
      "k6 run*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "webfetch": "allow"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "temperature": 0.3
    },
    "plan": {
      "mode": "primary",
      "temperature": 0.1
    }
  }
}
