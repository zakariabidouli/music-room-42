{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Music Room API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/profile": {
      "get": {
        "responses": {
          "200": {
            "description": "profile"
          }
        },
        "summary": "Get own profile"
      },
      "put": {
        "responses": {
          "200": {
            "description": "updated"
          }
        },
        "summary": "Update profile (visibility, musicPrefs)"
      }
    },
    "/api/v1/events": {
      "get": {
        "responses": {
          "200": {
            "description": "public + invited private events"
          }
        },
        "summary": "List events"
      },
      "post": {
        "responses": {
          "200": {
            "description": "event"
          }
        },
        "summary": "Create event (title, visibility, license open|invited-only|geofenced)"
      }
    },
    "/api/v1/events/{id}/queue": {
      "get": {
        "responses": {
          "200": {
            "description": "ranked suggestions"
          }
        },
        "summary": "Ranked queue"
      }
    },
    "/api/v1/events/{id}/suggest": {
      "post": {
        "responses": {
          "200": {
            "description": "suggestion"
          }
        },
        "summary": "Suggest track (Deezer metadata)"
      }
    },
    "/api/v1/music/search": {
      "get": {
        "responses": {
          "200": {
            "description": "Deezer metadata only"
          }
        },
        "summary": "Deezer proxy search?q="
      }
    },
    "/api/v1/playlists": {
      "post": {
        "responses": {
          "200": {
            "description": "playlist"
          }
        },
        "summary": "Create playlist"
      }
    },
    "/api/v1/playlists/{id}": {
      "get": {
        "responses": {
          "200": {
            "description": "playlist + tracks"
          }
        },
        "summary": "Get playlist"
      }
    },
    "/api/v1/playlists/{id}/reorder": {
      "patch": {
        "responses": {
          "200": {
            "description": "{version}"
          },
          "409": {
            "description": "stale version + current order"
          }
        },
        "summary": "Versioned reorder"
      }
    },
    "/api/v1/playlists/{id}/tracks": {
      "post": {
        "responses": {
          "200": {
            "description": "track"
          }
        },
        "summary": "Add track"
      }
    },
    "/api/v1/suggestions/{id}/vote": {
      "post": {
        "responses": {
          "200": {
            "description": "voted"
          },
          "409": {
            "description": "already voted"
          },
          "403": {
            "description": "license/geofence denied"
          }
        },
        "summary": "Atomic vote"
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          }
        },
        "summary": "Health"
      }
    },
    "/api/v1/billing/me": {
      "get": {
        "summary": "Free tier status",
        "responses": {
          "200": {
            "description": "tier"
          }
        }
      }
    },
    "/api/v1/billing/upgrade-mock": {
      "post": {
        "summary": "Mock upgrade (school demo, no payment)",
        "responses": {
          "200": {
            "description": "premium_mock"
          }
        }
      }
    },
    "/api/v1/events/nearby": {
      "get": {
        "summary": "Nearby public events (IoT/proximity)",
        "responses": {
          "200": {
            "description": "list"
          }
        }
      }
    },
    "/api/v1/sync/delta": {
      "get": {
        "summary": "Offline sync versions",
        "responses": {
          "200": {
            "description": "versions"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ]
}