# Copy to .env (never commit .env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/musicroom

# --- docker compose overrides (optional; sane defaults exist in docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=musicroom
# Backend URL baked into the Flutter web bundle (same-origin default).
WEB_BACKEND_URL=http://localhost:8080
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_KEY=change-me
JWT_SECRET=change-me-min-32-chars
DEEZER_API_BASE=https://api.deezer.com
PORT=3000
FLUTTER_BACKEND_URL=http://10.0.2.2:3000
